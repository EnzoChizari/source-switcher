{
  "manifest_version": 3,
  "name": "Source Switcher Tab Link",
  "version": "0.3.1",
  "description": "Follow a Helium tab and read available media headers for Source Switcher.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Source Switcher Tab Link", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
